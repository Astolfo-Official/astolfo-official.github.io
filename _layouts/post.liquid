---
layout: default
---
{% assign tags = page.tags | join: '' %}
{% assign categories = page.categories | join: '' %}
{% assign url_beginning = page.url | slice: 0, 6 %}
{% assign is_blog_post = false %}
{% assign is_news_post = false %}
{% if url_beginning == '/blog/' %}
  {% assign is_blog_post = true %}
{% elsif url_beginning == '/news/' %}
  {% assign is_news_post = true %}
{% endif %}

{% if page._styles %}
  <!-- Page/Post style -->
  <style type="text/css">
    {{ page._styles }}
  </style>
{% endif %}

<div class="post blog-post-detail{% if is_news_post %} news-post-detail{% endif %}">
  {% if is_blog_post or is_news_post %}
    <nav
      class="blog-post-back{% if is_news_post %} news-post-back{% endif %}"
      aria-label="{% if is_news_post %}News{% else %}Blog{% endif %} navigation"
    >
      <a href="{% if is_news_post %}{{ '/news/' | relative_url }}{% else %}{{ '/blog/' | relative_url }}{% endif %}">
        <i class="fa-solid fa-arrow-left-long" aria-hidden="true"></i>
        {% if is_news_post %}Back to News{% else %}Blog{% endif %}
      </a>
    </nav>
  {% endif %}

  {% if is_news_post %}
    <header class="news-post-hero{% unless page.news_image %} news-post-hero--text-only{% endunless %}">
      <div class="news-post-hero__copy">
        <p class="news-post-eyebrow">
          <span>News</span>
          <time datetime="{{ page.date | date_to_xmlschema }}">{{ page.date | date: '%b %-d, %Y' }}</time>
        </p>
        <h1 class="post-title">{{ page.title }}</h1>
        {% if page.description %}
          {% assign news_summary = page.news_summary | default: page.description %}
          <p class="blog-post-description">{{ news_summary | markdownify | remove: '<p>' | remove: '</p>' }}</p>
        {% endif %}
      </div>

      {% if page.news_image %}
        <div class="news-post-hero__media">
          {% if page.news_image contains '://' %}
            <img
              class="news-post-hero__image"
              src="{{ page.news_image }}"
              alt="{{ page.news_image_alt | default: page.title }}"
              loading="eager"
            >
          {% else %}
            {% assign news_image_path = page.news_image %}
            {% unless news_image_path contains '/' %}
              {% assign news_image_path = news_image_path | prepend: '/assets/img/publication_preview/' %}
            {% endunless %}
            {% assign news_image_alt = page.news_image_alt | default: page.title %}
            {%
              include figure.liquid
              loading="eager"
              path=news_image_path
              sizes="(min-width: 769px) 420px, 90vw"
              class="news-post-hero__image"
              avoid_scaling=true
              alt=news_image_alt
            %}
          {% endif %}
        </div>
      {% endif %}
    </header>
  {% else %}
    <header class="blog-post-hero">
      <h1 class="post-title">{{ page.title }}</h1>
      {% if page.description %}
        <p class="blog-post-description">{{ page.description }}</p>
      {% endif %}
    </header>
  {% endif %}

  {% if is_blog_post == false and is_news_post == false %}
    <div class="blog-post-tags">
      <span><i class="fa-solid fa-calendar fa-sm"></i>{{ page.date | date: '%b %-d, %Y' }}</span>
      {% if tags != '' %}
        {% for tag in page.tags %}
          <span><i class="fa-solid fa-hashtag fa-sm"></i>{{ tag }}</span>
        {% endfor %}
      {% endif %}
      {% if categories != '' %}
        {% for category in page.categories %}
          <span><i class="fa-solid fa-tag fa-sm"></i>{{ category }}</span>
        {% endfor %}
      {% endif %}
    </div>
  {% endif %}

  <article class="post-content blog-post-content{% if is_news_post %} news-post-content{% endif %}">
    {% if page.toc and page.toc.beginning %}
      <div id="table-of-contents">
        {% toc %}
      </div>
      <hr>
    {% endif %}
    <div id="markdown-content">
      {% if is_news_post %}
        <h2 class="news-post-content__heading">{{ page.news_section_title | default: 'About this update' }}</h2>
      {% endif %}
      {{ content }}
    </div>
  </article>

  {% if page.citation %}
    {% include citation.liquid %}
  {% endif %}

  {% if page.related_publications %}
    <div class="related-publications publications-page">
      <h2 class="related-publications__heading">
        {% if is_news_post %}Related research{% else %}References{% endif %}
      </h2>
      <div class="publications">
        {% bibliography --group_by none --cited_in_order %}
      </div>
    </div>
    <script>
      document.addEventListener('DOMContentLoaded', function () {
        const relatedEntries = Array.from(document.querySelectorAll('.related-publications .bibliography > li'));
        if (relatedEntries.length === 0) return;

        const assignFallbackNumbers = () => {
          const relatedCount = relatedEntries.length;
          relatedEntries.forEach((entry, index) => {
            const numberElement = entry.querySelector('.publication-number');
            if (numberElement) numberElement.textContent = relatedCount - index;
          });
        };

        fetch("{{ '/publications/' | relative_url }}")
          .then((response) => {
            if (!response.ok) throw new Error('Could not load publications page');
            return response.text();
          })
          .then((html) => {
            const documentParser = new DOMParser();
            const publicationsDocument = documentParser.parseFromString(html, 'text/html');
            const publicationEntries = Array.from(publicationsDocument.querySelectorAll('.bibliography > li'));
            if (publicationEntries.length === 0) throw new Error('No publication entries found');
            const publicationCount = publicationEntries.length;
            const publicationNumbersByKey = new Map();

            publicationEntries.forEach((entry, index) => {
              const publicationKey = entry.querySelector('.publication-entry-column')?.id;
              if (publicationKey) publicationNumbersByKey.set(publicationKey, publicationCount - index);
            });

            let assignedCount = 0;
            relatedEntries.forEach((entry) => {
              const publicationKey = entry.querySelector('.publication-entry-column')?.id;
              const numberElement = entry.querySelector('.publication-number');
              if (publicationKey && numberElement && publicationNumbersByKey.has(publicationKey)) {
                numberElement.textContent = publicationNumbersByKey.get(publicationKey);
                assignedCount += 1;
              }
            });

            if (assignedCount === 0) assignFallbackNumbers();
          })
          .catch(assignFallbackNumbers);
      });
    </script>
  {% endif %}

  {% if is_news_post %}
    {% assign news_detail_items = site.news | where_exp: 'item', 'item.inline != true' | sort: 'date' %}
    {% assign previous_news = null %}
    {% assign next_news = null %}
    {% assign previous_candidate = null %}
    {% assign current_news_found = false %}
    {% for news_item in news_detail_items %}
      {% if current_news_found and next_news == null %}
        {% assign next_news = news_item %}
      {% endif %}
      {% if news_item.url == page.url %}
        {% assign previous_news = previous_candidate %}
        {% assign current_news_found = true %}
      {% elsif current_news_found == false %}
        {% assign previous_candidate = news_item %}
      {% endif %}
    {% endfor %}

    {% if previous_news or next_news %}
      <nav class="section-navigation news-post-navigation" aria-label="News navigation" data-section-navigation>
        {% if previous_news %}
          <a
            class="section-navigation__link section-navigation__link--previous"
            href="{{ previous_news.url | relative_url }}"
            aria-label="Previous news: {{ previous_news.title }}"
            aria-keyshortcuts="ArrowLeft"
            data-section-previous
          >
            <i class="fa-solid fa-arrow-left-long" aria-hidden="true"></i>
            <span>
              <small>Previous news</small>
              <strong>{{ previous_news.title }}</strong>
            </span>
          </a>
        {% endif %}
        {% if next_news %}
          <a
            class="section-navigation__link section-navigation__link--next"
            href="{{ next_news.url | relative_url }}"
            aria-label="Next news: {{ next_news.title }}"
            aria-keyshortcuts="ArrowRight"
            data-section-next
          >
            <span>
              <small>Next news</small>
              <strong>{{ next_news.title }}</strong>
            </span>
            <i class="fa-solid fa-arrow-right-long" aria-hidden="true"></i>
          </a>
        {% endif %}
      </nav>
    {% endif %}
  {% endif %}

  {% comment %}
    related_posts section intentionally disabled
  {% endcomment %}

  {% if site.disqus_shortname and page.disqus_comments %}
    {% include disqus.liquid %}
  {% endif %}
  {% if site.giscus and page.giscus_comments %}
    {% include giscus.liquid %}
  {% endif %}
</div>
