---
---
{% assign title_link = '' %}
{% if entry.url %}
  {% assign title_link = entry.url %}
{% elsif entry.doi %}
  {% assign title_link = entry.doi | prepend: 'https://doi.org/' %}
{% elsif entry.html %}
  {% if entry.html contains '://' %}
    {% assign title_link = entry.html %}
  {% else %}
    {% assign title_link = entry.html | prepend: '/assets/html/' | relative_url %}
  {% endif %}
{% elsif entry.pdf %}
  {% if entry.pdf contains '://' %}
    {% assign title_link = entry.pdf %}
  {% else %}
    {% assign title_link = entry.pdf | prepend: '/assets/pdf/' | relative_url %}
  {% endif %}
{% elsif entry.website %}
  {% assign title_link = entry.website %}
{% endif %}

<div class="cv-publication-row" data-bib-key="{{ entry.key }}">
  <div class="cv-publication-number-column">
    <span class="cv-publication-number">{{ index }}</span>
  </div>
  <div class="cv-publication-copy">
    <h6 class="title font-weight-bold ml-1 ml-md-4">
      {% if title_link != blank %}
        <a href="{{ title_link }}">{{ entry.title }}</a>
      {% else %}
        {{ entry.title }}
      {% endif %}
    </h6>

    <h6 class="cv-publication-authors ml-1 ml-md-4">
      {% assign author_array_size = entry.author_array | size %}
      {% assign leading_author_limit = author_array_size %}
      {% assign more_authors = 0 %}
      {% if site.max_author_limit and author_array_size > site.max_author_limit %}
        {% assign leading_author_limit = site.max_author_limit | minus: 1 %}
        {% assign more_authors = author_array_size | minus: site.max_author_limit %}
      {% endif %}

      {% assign more_authors_hide = more_authors | append: ' more author' %}
      {% if more_authors > 1 %}
        {% assign more_authors_hide = more_authors_hide | append: 's' %}
      {% endif %}
      {% assign more_authors_show = '' %}
      {% for author in entry.author_array offset: leading_author_limit limit: more_authors %}
        {% assign hidden_author_last = author.last | regex_replace: '([*∗†‡§¶‖&^]+)', '<sup>\1</sup>' %}
        {% assign hidden_author_last_name = author.last | regex_replace: '[*∗†‡§¶‖&^]', '' %}
        {% assign hidden_author_is_self = false %}
        {% if site.scholar.last_name contains hidden_author_last_name %}
          {% if site.scholar.first_name contains author.first %}
            {% assign hidden_author_is_self = true %}
          {% endif %}
        {% endif %}
        {% if hidden_author_is_self %}
          {% assign more_authors_show = more_authors_show
            | append: '<u>'
            | append: author.first
            | append: ' '
            | append: hidden_author_last
            | append: '</u>'
          %}
        {% else %}
          {% assign more_authors_show = more_authors_show | append: author.first | append: ' ' | append: hidden_author_last %}
        {% endif %}
        {% unless forloop.last %}
          {% assign more_authors_show = more_authors_show | append: ', ' %}
        {% endunless %}
      {% endfor %}

      {%- for author in entry.author_array -%}
        {%- if more_authors > 0 and forloop.index > leading_author_limit and forloop.last == false -%}
          {% continue %}
        {%- endif -%}
        {%- assign author_last_name = author.last | regex_replace: '[*∗†‡§¶‖&^]', '' -%}
        {%- assign author_last_html = author.last | regex_replace: '([*∗†‡§¶‖&^]+)', '<sup>\1</sup>' -%}
        {%- assign author_is_self = false -%}
        {%- if site.scholar.last_name contains author_last_name -%}
          {%- if site.scholar.first_name contains author.first -%}
            {%- assign author_is_self = true -%}
          {%- endif -%}
        {%- endif -%}

        {%- if more_authors > 0 and forloop.last -%}
          {%- if leading_author_limit > 0 -%}{{- ', ' -}}{%- endif -%}
          <span
            class="more-authors"
            role="button"
            tabindex="0"
            aria-expanded="false"
            title="click to view {{ more_authors_hide }}"
            data-collapsed-label="{{ more_authors_hide }}"
            data-expanded-authors="{{ more_authors_show | escape }}"
          >
            {{- more_authors_hide -}}
          </span>
          {{- ', and ' -}}
        {%- elsif forloop.first == false -%}
          {%- if forloop.last -%}
            {%- if author_array_size > 2 -%}{{- ', and ' -}}{%- else -%}{{- ' and ' -}}{%- endif -%}
          {%- else -%}
            {{- ', ' -}}
          {%- endif -%}
        {%- endif -%}
        {%- if author_is_self -%}
          <u>
            {{- author.first }}
            {{ author_last_html -}}
          </u>
        {%- else -%}
          {{ author.first }}
          {{ author_last_html }}
        {%- endif %}
      {%- endfor -%}
    </h6>

    {% assign journal_name = entry.shortjournal | default: entry.journal %}
    {% assign normalized_pages = entry.pages | replace: '--', '-' %}
    {% assign has_embedded_issue = false %}
    {% if entry.volume and entry.volume contains '(' %}
      {% assign has_embedded_issue = true %}
    {% endif %}
    {% assign has_arxiv_identifier = false %}
    {% if entry.eprint or entry.archiveprefix == 'arXiv' or entry.publisher == 'arXiv' %}
      {% assign has_arxiv_identifier = true %}
    {% elsif entry.number and entry.number contains 'arXiv:' %}
      {% assign has_arxiv_identifier = true %}
    {% endif %}
    {% assign arxiv_identifier = entry.eprint | default: entry.number %}

    <div class="cv-publication-citation ml-1 ml-md-4">
      {% if entry.type == 'article' %}
        <em>{{ journal_name }}</em>
        {% if entry.year %} {{ entry.year }}{% endif %}
        {% if entry.volume %}, {{ entry.volume }}{% endif %}
        {% if entry.number and has_embedded_issue == false %} ({{ entry.number }}){% endif %}
        {% if normalized_pages != blank %}, {{ normalized_pages }}{% endif %}.
      {% elsif has_arxiv_identifier %}
        <em>arXiv</em>
        {% if entry.year %} {{ entry.year }}{% endif %}
        {% if arxiv_identifier %}, arXiv:{{ arxiv_identifier | remove: 'arXiv:' }}{% endif %}.
      {% elsif entry.publisher %}
        <em>{{ entry.publisher }}</em>
        {% if entry.year %} {{ entry.year }}{% endif %}.
      {% elsif entry.year %}
        {{ entry.year }}.
      {% endif %}
    </div>
  </div>
</div>
