{% comment %}
  CV publications are generated from _bibliography/papers.bib through Jekyll Scholar.
{% endcomment %}

<div id="cv-publications-from-bib" class="cv-bibliography">
  {% bibliography --file papers --template cv_bib %}
</div>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    const publicationList = document.getElementById('cv-publications-from-bib');
    if (!publicationList) return;

    const publicationNumbers = Array.from(publicationList.querySelectorAll('.cv-publication-number'));
    publicationNumbers.forEach((numberElement, index) => {
      numberElement.textContent = publicationNumbers.length - index;
    });

    const toggleMiddleAuthors = (element) => {
      const isExpanded = element.getAttribute('aria-expanded') === 'true';
      element.innerHTML = isExpanded ? element.dataset.collapsedLabel : element.dataset.expandedAuthors;
      element.setAttribute('aria-expanded', isExpanded ? 'false' : 'true');
      element.title = isExpanded ? `click to view ${element.dataset.collapsedLabel}` : 'click to hide middle authors';
    };

    publicationList.querySelectorAll('.more-authors').forEach((element) => {
      element.addEventListener('click', () => toggleMiddleAuthors(element));
      element.addEventListener('keydown', (event) => {
        if (event.key === 'Enter' || event.key === ' ') {
          event.preventDefault();
          toggleMiddleAuthors(element);
        }
      });
    });
  });
</script>
